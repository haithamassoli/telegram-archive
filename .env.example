# Hugging Face — accept the model terms on this account first
HF_TOKEN=

# Cloudflare R2 (access key 32 hex chars, secret 64)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ARCHIVE_BUCKET=telegram-archive
R2_MEDIA_BUCKET=lessons-media

# Convex — CONVEX_URL/CONVEX_DEPLOYMENT are written to .env.local by
# `npx convex dev`; nothing to set here.

# Meilisearch
MEILI_URL=
MEILI_ADMIN_KEY=
MEILI_SEARCH_KEY=

# Telegram — dedicated archive account; the session file is a secret
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=secrets/archive.session
